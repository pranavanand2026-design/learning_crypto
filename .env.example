# Copy to .env for local development. Never commit .env.
DEBUG=True
DJANGO_SECRET_KEY=change-me
# Free "demo" key from https://www.coingecko.com/en/api (optional, avoids rate limits)
COINGECKO_API_KEY=

# Production (Cloud Run)
# ALLOWED_HOSTS=your-service.run.app
# CSRF_TRUSTED_ORIGINS=https://your-service.run.app
# CORS_ALLOWED_ORIGINS=https://your-service.run.app
# DATABASE_URL=postgres://user:pass@host:5432/cryptodash

# reCAPTCHA Enterprise (optional; login works without it when unset)
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_PROJECT_ID=
# RECAPTCHA_API_KEY=
